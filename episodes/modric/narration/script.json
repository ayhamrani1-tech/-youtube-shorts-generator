{
  "lines": [
    {
      "n": 1,
      "file": "01_hook",
      "id": "hook",
      "chapter": "intro",
      "text": "خمّن اللاعب من انتقالاته!"
    },
    {
      "n": 2,
      "file": "02_c1",
      "id": "c1",
      "chapter": "clues",
      "text": "وقّع أول عقد احترافي مع دينامو زغرب عام ألفين وثلاثة."
    },
    {
      "n": 3,
      "file": "03_c2",
      "id": "c2",
      "chapter": "clues",
      "text": "ثم أُعير إلى زرينيسكي موستار في البوسنة."
    },
    {
      "n": 4,
      "file": "04_c3",
      "id": "c3",
      "chapter": "clues",
      "text": "وبعدها إعارة ثانية إلى إنتر زابريشيتش."
    },
    {
      "n": 5,
      "file": "05_c4",
      "id": "c4",
      "chapter": "clues",
      "text": "ثم عاد إلى دينامو زغرب وتألق حتى ألفين وثمانية."
    },
    {
      "n": 6,
      "file": "06_c5",
      "id": "c5",
      "chapter": "clues",
      "text": "ثم انتقل إلى توتنهام في إنجلترا."
    },
    {
      "n": 7,
      "file": "07_c6",
      "id": "c6",
      "chapter": "clues",
      "text": "وفي ألفين واثني عشر انضم إلى ريال مدريد، وبقي ثلاثة عشر عامًا."
    },
    {
      "n": 8,
      "file": "08_c7",
      "id": "c7",
      "chapter": "clues",
      "text": "واليوم يلعب مع إيه سي ميلان."
    },
    {
      "n": 9,
      "file": "09_reveal",
      "id": "reveal",
      "chapter": "answer",
      "text": "إنه الكرواتي لوكا مودريتش!"
    },
    {
      "n": 10,
      "file": "10_outro",
      "id": "outro",
      "chapter": "outro",
      "text": "هل عرفته؟ اكتب في التعليقات."
    }
  ],
  "chapters": [
    "intro",
    "clues",
