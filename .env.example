# Copy this file to `.env` (same folder) and fill in your own values. `.env` is ignored by git.
# Never paste these values into code, Discord messages or screenshots.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=paste-your-new-token-here

# Discord user IDs allowed to start or cancel jobs (comma-separated). Discord: Settings → Advanced →
# Developer Mode on, then right-click your name → Copy User ID. Empty = nobody can start jobs.
ALLOWED_USER_IDS=123456789012345678

# Optional: your test server's ID, so slash commands appear immediately (global sync can take up to an hour)
DISCORD_GUILD_ID=

# Attachment size limit in MB (10 for most servers; boosted servers allow more)
MAX_UPLOAD_MB=10

# Narration for automatic episodes: tts = local SILMA voice (preview until you approve it), none = existing audio only
FVS_VOICE=tts

# Path to node.exe if `node` is not on PATH
NODE_EXE=node
